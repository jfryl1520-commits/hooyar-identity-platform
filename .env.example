PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./database.sqlite
NODE_ENV=development

# Serverless deployment (Netlify). When TURSO_DATABASE_URL is set, the app talks
# to a hosted libSQL/Turso database over HTTP instead of a local SQLite file,
# because Netlify's filesystem is ephemeral. Leave both unset to keep using
# DATABASE_PATH locally. Create a free database at https://turso.tech and copy
# its URL and an auth token into Netlify's environment variables.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Signing key for JWT sessions. At least 32 random characters. `openssl rand -base64 48` is a good source.
# Must NOT be left at this placeholder value — the server refuses the sample value.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h

# Optional: dedicated AES key for encrypting admin TOTP secrets. When empty, derives from JWT_SECRET.
# Set this before going to production so rotating the JWT signing key does not lock out MFA admins.
MFA_ENCRYPTION_KEY=

# Initial administrator. Created only if both are set. Password must be 12+ characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Shared password for the seeded demo customers; only used when the customers table is empty.
DEMO_PASSWORD=123456

# Set only when running behind a trusted proxy (Railway, nginx) so req.ip
# reports the real client. Use "1" for a single hop, or "true"/a subnet list.
TRUST_PROXY=
